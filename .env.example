# GEMINI_API_KEY: Required for Gemini AI API calls (Satya's Learning Assistant Chatbot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CASHFREE PAYMENTS (SANDBOX MODE FIRST):
# Configure your Cashfree Sandbox credentials from https://merchant.cashfree.com/merchants/pg/developers/api-keys
# CASHFREE_WEBHOOK_SECRET is your Cashfree PG Secret Key used on the server to verify webhook signatures
# (HMAC-SHA256 over x-webhook-timestamp + raw request body, Base64 encoded) per Cashfree official docs.
CASHFREE_ENV="SANDBOX"
CASHFREE_APP_ID="CF_SANDBOX_PLACEHOLDER_APP_ID"
CASHFREE_SECRET_KEY="cfsk_ma_test_placeholder_secret_key"
CASHFREE_WEBHOOK_SECRET="cfsk_ma_test_placeholder_secret_key"

# AUTHENTICATION & SERVER-SIDE ADMIN BOOTSTRAP:
# The first admin account is provisioned exclusively on the server at startup.
# New user signups always receive the 'student' (user) role.
ADMIN_EMAIL="tarunpediredla9966@gmail.com"
ADMIN_INITIAL_PASSWORD="SatyaAdmin@2026"
AUTH_TOKEN_SECRET="satyas_education_hmac_secret_change_in_production"
