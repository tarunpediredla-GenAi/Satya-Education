# ============================================================================
# 1. FIREBASE CONFIGURATION (Used by Vite Frontend & Vercel Production Build)
# ============================================================================
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# ============================================================================
# 2. SERVER AUTHENTICATION & INITIAL ADMIN BOOTSTRAP (Backend Only)
# ============================================================================
ADMIN_EMAIL="tarunpediredla9966@gmail.com"
ADMIN_INITIAL_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"
AUTH_TOKEN_SECRET="YOUR_RANDOM_64_CHAR_HMAC_SECRET"

# ============================================================================
# 3. CASHFREE PAYMENT GATEWAY (Server-Side Only — Never expose to client)
# ============================================================================
# Set CASHFREE_ENV="SANDBOX" for testing or "PRODUCTION" for live payments
CASHFREE_ENV="SANDBOX"
CASHFREE_APP_ID="TEST_CASHFREE_APP_ID_PLACEHOLDER"
CASHFREE_SECRET_KEY="TEST_CASHFREE_SECRET_KEY_PLACEHOLDER"
# CASHFREE_WEBHOOK_SECRET: Used as the Cashfree PG Secret Key to verify webhook
# signatures using x-webhook-timestamp + raw request body (HMAC-SHA256 Base64)
CASHFREE_WEBHOOK_SECRET="TEST_CASHFREE_WEBHOOK_SECRET_PLACEHOLDER"

# ============================================================================
# 4. GEMINI AI & APPLICATION URL
# ============================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://satyaeducation.in"
