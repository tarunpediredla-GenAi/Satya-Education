rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'phone', 'bio', 'createdAt', 'lastLoginAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.photoURL is string && data.photoURL.size() <= 1024 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 600)) &&
        data.role is string && (data.role == 'user' || data.role == 'student' || (data.role == 'admin' && isAdmin())) &&
        (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (data.lastLoginAt is timestamp || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidBook(data) {
      return data.keys().hasAll(['id', 'title', 'author', 'category', 'subcategory', 'priceInr', 'ebookPriceInr', 'format', 'stock', 'description', 'isbn', 'pages', 'language', 'archived', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
        data.category is string && (data.category == 'Technology' || data.category == 'Stories & Literature') &&
        data.subcategory is string && data.subcategory.size() >= 1 && data.subcategory.size() <= 80 &&
        data.priceInr is number && data.priceInr >= 0 && data.priceInr <= 100000 &&
        data.ebookPriceInr is number && data.ebookPriceInr >= 0 && data.ebookPriceInr <= 100000 &&
        data.format is string && (data.format == 'Both' || data.format == 'Hardcover' || data.format == 'E-Book') &&
        data.stock is number && data.stock >= 0 && data.stock <= 100000 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 4000 &&
        data.isbn is string && data.isbn.size() >= 1 && data.isbn.size() <= 40 &&
        data.pages is number && data.pages >= 1 && data.pages <= 10000 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
        data.archived is bool;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'title', 'instructor', 'subject', 'level', 'priceInr', 'language', 'duration', 'description', 'archived', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.instructor is string && data.instructor.size() >= 1 && data.instructor.size() <= 120 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
        data.level is string && (data.level == 'Beginner' || data.level == 'Intermediate' || data.level == 'Advanced') &&
        data.priceInr is number && data.priceInr >= 0 && data.priceInr <= 200000 &&
        data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
        data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 40 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 4000 &&
        data.archived is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'totalInr', 'paymentId', 'razorpayOrderId', 'paymentMode', 'status', 'shippingStatus', 'shippingAddressSummary', 'itemsSummary', 'itemIds', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254 &&
        data.totalInr is number && data.totalInr >= 0 && data.totalInr <= 1000000 &&
        data.paymentId is string && data.paymentId.size() >= 1 && data.paymentId.size() <= 128 &&
        data.razorpayOrderId is string && data.razorpayOrderId.size() >= 1 && data.razorpayOrderId.size() <= 128 &&
        data.paymentMode is string && (data.paymentMode == 'cashfree_sandbox' || data.paymentMode == 'cashfree_live' || data.paymentMode == 'razorpay_live' || data.paymentMode == 'demo_verified') &&
        data.status is string && (data.status == 'paid' || data.status == 'failed' || data.status == 'pending' || data.status == 'refunded') &&
        data.shippingStatus is string && (data.shippingStatus == 'not_applicable' || data.shippingStatus == 'processing' || data.shippingStatus == 'shipped' || data.shippingStatus == 'delivered') &&
        data.shippingAddressSummary is string && data.shippingAddressSummary.size() <= 600 &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 2000 &&
        data.itemIds is string && data.itemIds.size() >= 1 && data.itemIds.size() <= 1000;
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['id', 'userId', 'itemId', 'itemType', 'orderId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'itemId', 'itemType', 'orderId', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidId(data.itemId) &&
        data.itemType is string && (data.itemType == 'course' || data.itemType == 'ebook' || data.itemType == 'physical_book') &&
        isValidId(data.orderId);
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['id', 'userId', 'courseId', 'lessonId', 'playbackSeconds', 'completed', 'notes', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'courseId', 'lessonId', 'playbackSeconds', 'completed', 'notes', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.userId == request.auth.uid &&
        isValidId(data.courseId) &&
        isValidId(data.lessonId) &&
        data.playbackSeconds is number && data.playbackSeconds >= 0 && data.playbackSeconds <= 86400 &&
        data.completed is bool &&
        data.notes is string && data.notes.size() <= 4000;
    }

    // Connection test endpoint
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Admins Registry (Read-only from client; provisioned externally/console)
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow write: if false;
    }

    // Users Collection (PII Protected; default role is 'user', users cannot escalate their own role to 'admin')
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId) &&
        isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phone', 'bio', 'lastLoginAt', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Books Collection (Public Catalog Overrides & Admin Additions)
    match /books/{bookId} {
      allow get: if isValidId(bookId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(bookId) && isValidBook(incoming()) && incoming().id == bookId;
      allow delete: if isAdmin() && isValidId(bookId);
    }

    // Courses Collection (Public Catalog Overrides & Admin Additions)
    match /courses/{courseId} {
      allow get: if isValidId(courseId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(courseId) && isValidCourse(incoming()) && incoming().id == courseId;
      allow delete: if isAdmin() && isValidId(courseId);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only the trusted Admin SDK backend creates or modifies payments.
      allow create, update, delete: if false;
    }

    // Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && isValidId(enrollmentId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Learning Progress Collection
    match /progress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && isValidId(progressId) && isValidProgress(incoming()) &&
        incoming().id == progressId &&
        incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(progressId) && existing().userId == request.auth.uid;
    }

    match /lessonProgress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && isValidId(progressId) && isValidProgress(incoming()) &&
        incoming().id == progressId &&
        incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(progressId) && existing().userId == request.auth.uid;
    }

    // Private server-side records (including password hashes and payment data).
    // These must never be accessible through the browser Firebase SDK.
    match /server_users/{docId} { allow read, write: if false; }
    match /server_books/{docId} { allow read, write: if false; }
    match /server_courses/{docId} { allow read, write: if false; }
    match /server_orders/{docId} { allow read, write: if false; }
    match /server_enrollments/{docId} { allow read, write: if false; }
    match /server_progress/{docId} { allow read, write: if false; }
    match /server_webhooks/{docId} { allow read, write: if false; }
  }
}
